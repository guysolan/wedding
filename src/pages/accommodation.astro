---
import { accommodation } from "../content/accommodation";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main class="space-y-8 mx-auto mb-6 max-w-[800px]">
            <div class="space-y-4 p-4 pb-0 text-zinc-800 text-lg">
                <div
                    class="flex flex-col bg-beige shadow-md mx-auto p-6 border border-zinc-400 rounded-lg"
                >
                    <h3 class="mb-4 text-zinc-600 text-lg">
                        For the Party People
                    </h3>
                    <p class="leading-relaxed">
                        For the night of the wedding, everyone is more than
                        welcome to stay. Just bring a sleeping bag and roll mat,
                        unless you've managed to cut a deal with the bride and
                        groom.
                    </p>
                </div>
                <div
                    class="flex flex-col bg-beige shadow-md mx-auto p-6 border border-zinc-400 rounded-lg"
                >
                    <h3 class="mb-4 text-zinc-600 text-lg">
                        For the Princesses
                    </h3>
                    <p class="leading-relaxed">
                        For those who prefer a little more luxury, here are some
                        local options:
                    </p>
                </div>
            </div>
            <ul class="space-y-8 my-4 px-4">
                {
                    accommodation.map((a) => (
                        <li class="flex lg:flex-row-reverse flex-col lg:items-start lg:gap-6 bg-beige shadow-md hover:shadow-lg mx-auto p-6 border border-zinc-400 rounded-lg transition-shadow duration-300">
                            <div class="flex-1 space-y-3">
                                <div class="space-y-1">
                                    <h2 class="font-semibold text-zinc-800 text-xl lg:text-2xl">
                                        {a.name}
                                    </h2>
                                    <p class="text-zinc-700 text-lg">
                                        {a.location}
                                    </p>
                                </div>
                                <ul class="flex flex-wrap gap-2 py-2">
                                    <li class="inline-flex items-center px-3 py-1 border border-blue-700 rounded-full font-medium text-blue-700 text-sm">
                                        {a.travel} minute drive
                                    </li>
                                    <li class="inline-flex items-center px-3 py-1 border border-green-700 rounded-full font-medium text-green-700 text-sm">
                                        {a.price}
                                    </li>
                                </ul>
                                <a
                                    target="_blank"
                                    href={a.link}
                                    class="group inline-flex items-center bg-[#DCA225] hover:bg-[#c28a10] shadow-sm mt-4 px-4 py-2 rounded-md font-medium text-white text-sm transition-all duration-200 cursor-pointer"
                                >
                                    <span>Visit website</span>
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-0.5 transform"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="3"
                                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                        />
                                    </svg>
                                </a>
                            </div>
                            <div class="shadow-sm mt-4 lg:mt-0 rounded-md lg:w-1/2 overflow-hidden">
                                <Image
                                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                    width={450}
                                    height={300}
                                    src={a.image}
                                    alt={a.name}
                                />
                            </div>
                        </li>
                    ))
                }
            </ul>
        </main>
        <Footer />
    </body>
</html>
